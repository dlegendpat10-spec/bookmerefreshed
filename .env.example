PORT=5000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Connection (Direct PostgreSQL connection for pg Pool)
DATABASE_URL=postgresql://postgres:password@localhost:5432/bookme

# Redis (BullMQ queues)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=super-secret-jwt-key-change-in-production-32chars

# CORS Origin
FRONTEND_URL=http://localhost:5173,bookme-indol-six.vercel.app
